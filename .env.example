# 默认使用 DeepSeek；也可把 AI_PROVIDER 改成 glm
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# GLM 作为备选服务商
GLM_API_KEY=
GLM_MODEL=glm-5

# SimNow 测试账号。参数从 SimNow 当前控制台复制，勿使用网上过期前置地址
SIMNOW_USERNAME=
SIMNOW_PASSWORD=
SIMNOW_BROKER_ID=
SIMNOW_MD_ADDRESS=
SIMNOW_TD_ADDRESS=

# 控制台提供时再填写；AppID 映射到 CTP 的“产品名称”字段
SIMNOW_APP_ID=
SIMNOW_AUTH_CODE=
SIMNOW_PRODUCT_INFO=
