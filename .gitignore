# ---- 密钥 ----------------------------------------------------------------
# .env 是本机明文配置（含 API Key 与 SimNow 账号密码），任何情况下都不要提交
.env
*.env
!.env.example

# ---- 虚拟环境与缓存 ------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
.tmp/
*.egg-info/

# ---- 运行时数据 ----------------------------------------------------------
# SQLite 账本、WAL 文件与日志属于本机运行产物
data/runtime/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.log

# ---- 第三方客户端产物 ----------------------------------------------------
.vntrader/

# ---- 回放脚本输出 --------------------------------------------------------
replay_output/

# ---- 编辑器 / 系统 -------------------------------------------------------
.idea/
.vscode/
.DS_Store
Thumbs.db
